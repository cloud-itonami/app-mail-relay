;; app-mail-relay —— relay.itonami.cloud の受信箱アカウント面。
;;
;; 依存は persona 1 本。1 通ごとの振り分け判断（誰宛か・出してよいか・
;; 差出人が想定内か）は persona.relay が既に持っているので、ここでは
;; 作り直さない。ここが持つのはその上の層 —— アカウントを開き、閉じ、
;; 鍵を回す判断だけ。
;;
;; IO は持たない。SMTP・Email Routing・kotobase への保管・鍵の生成は
;; すべて host（Cloudflare Email Worker）側の機構。
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/persona
        {:git/url "https://github.com/kotoba-lang/persona.git"
         :git/sha "5b3ca005231c3f1150aaf2960d9af5ffc8b20866"}}
 :aliases
 {;; west checkout の中で開発するとき。
  :local {:override-deps
          {io.github.kotoba-lang/persona {:local/root "../../kotoba-lang/persona"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
